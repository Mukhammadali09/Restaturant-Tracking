{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.+\\.(?:js|css|ico|png|jpg|svg|woff2?))", "dest": "static/$1" },
    { "src": "/(.*)", "dest": "static/index.html" }
  ]
}
